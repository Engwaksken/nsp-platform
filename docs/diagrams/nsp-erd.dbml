Ref: ai_consents.user_id > users.id
Ref: ai_interactions.user_id > users.id
Ref: announcements.created_by > users.id
Ref: announcements.sent_by > users.id
Ref: audit_logs.actor_id > users.id
Ref: builder_curricula.copied_from_id > builder_curricula.id
Ref: builder_curricula.created_by > users.id
Ref: builder_curricula.published_by > users.id
Ref: builder_curricula.updated_by > users.id
Ref: builder_documents.startup_uuid > startups.uuid
Ref: builder_documents.submission_id > venture_step_submissions.id
Ref: builder_document_versions.created_by > users.id
Ref: builder_document_versions.document_id > builder_documents.id
Ref: builder_modules.curriculum_id > builder_curricula.id
Ref: builder_step_definitions.curriculum_id > builder_curricula.id
Ref: builder_step_definitions.module_id > builder_modules.id
Ref: builder_step_events.startup_uuid > startups.uuid
Ref: builder_step_events.submission_id > venture_step_submissions.id
Ref: builder_step_events.user_id > users.id
Ref: capital_document_requests.introduction_uuid > investor_introductions.uuid
Ref: capital_document_requests.investor_user_id > users.id
Ref: capital_document_requests.responded_by > users.id
Ref: capital_document_requests.startup_uuid > startups.uuid
Ref: capital_share_grants.granted_by > users.id
