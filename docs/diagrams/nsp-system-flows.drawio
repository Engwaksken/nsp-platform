etry x="490" y="10" width="200" height="110" as="geometry" /></mxCell><mxCell id="p7-a4" value="400 error page (never&lt;br&gt;redirects elsewhere)" style="rounded=1;arcSize=50;strokeWidth=2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p7-a-n"><mxGeometry x="505" y="165" width="170" height="60" as="geometry" /></mxCell><mxCell id="p7-a5" value="Sign in, pick a startup&lt;br&gt;(active member), see&lt;br&gt;ims_prefill fields" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p7-a-n"><mxGeometry x="717" y="27" width="186" height="76" as="geometry" /></mxCell><mxCell id="p7-a6" value="Allow? (owner or&lt;br&gt;founder turns sharing&lt;br&gt;on if it is off)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p7-a-f"><mxGeometry x="930" y="10" width="200" height="110" as="geometry" /></mxCell><mxCell id="p7-a7" value="IMS gets&lt;br&gt;error=access_denied" style="rounded=1;arcSize=50;strokeWidth=2;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;fontSize=11;" vertex="1" parent="p7-a-i"><mxGeometry x="945" y="35" width="170" height="60" as="geometry" /></mxCell><mxCell id="p7-a8" value="Single-use code (5 min,&lt;br&gt;tied to client and URI);&lt;br&gt;redirect back" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p7-a-n"><mxGeometry x="1157" y="27" width="186" height="76" as="geometry" /></mxCell><mxCell id="p7-a9" value="IMS checks state, calls&lt;br&gt;POST /api/v1/connect/token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;fontSize=11;" vertex="1" parent="p7-a-i"><mxGeometry x="1377" y="27" width="186" height="76" as="geometry" /></mxCell><mxCell id="p7-a10" value="Code valid, consent&lt;br&gt;on, still a member?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSi