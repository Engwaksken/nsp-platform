" height="110" as="geometry" /></mxCell><mxCell id="p6-y1" value="Published on&lt;br&gt;/opportunities" style="rounded=1;arcSize=50;strokeWidth=2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p6-m-r"><mxGeometry x="505" y="35" width="170" height="60" as="geometry" /></mxCell><mxCell id="p6-n1" value="Rejected (later&lt;br&gt;unpublish or archive)" style="rounded=1;arcSize=50;strokeWidth=2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p6-m-r"><mxGeometry x="725" y="35" width="170" height="60" as="geometry" /></mxCell><mxCell id="p6-m2" value="Investor or expert&lt;br&gt;profile (status&lt;br&gt;pending)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="p6-m-m"><mxGeometry x="937" y="27" width="186" height="76" as="geometry" /></mxCell><mxCell id="p6-d2" value="Verify? (verify-&lt;br&gt;investors, manage-&lt;br&gt;experts)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="p6-m-s"><mxGeometry x="930" y="10" width="200" height="110" as="geometry" /></mxCell><mxCell id="p6-y2" value="Verified: role&lt;br&gt;investor or expert&lt;br&gt;assigned" style="rounded=1;arcSize=50;strokeWidth=2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p6-m-r"><mxGeometry x="945" y="35" width="170" height="60" as="geometry" /></mxCell><mxCell id="p6-n2" value="Rejected or suspended&lt;br&gt;(note required);&lt;br&gt;role removed" style="rounded=1;arcSize=50;strokeWidth=2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p6-m-r"><mxGeometry x="1165" y="35" width="170" height="60" as="geometry" /></mxCell><mxCell id="p6-m3" value="Startup posts a&lt;br&gt;vacancy (open)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="p6-m-m"><m