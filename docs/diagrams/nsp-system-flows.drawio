<mxfile host="app.diagrams.net" type="device"><diagram name="1. System context" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1032" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1-title" value="1. System context" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="36" as="geometry" /></mxCell><mxCell id="p1-sub" value="Who uses Hive NSP, the modules they reach, and the outside systems NSP talks to. Every module route sits behind its feature flag (feature:key, 404 when off); admin routes need auth + admin + mfa." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1400" height="40" as="geometry" /></mxCell><mxCell id="p1-ctx-t" value="Hive NSP: people, modules and external systems" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1600" height="28" as="geometry" /></mxCell><mxCell id="p1-ctx-ppl" value="People" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#999999;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="292" width="1580" height="130" as="geometry" /></mxCell><mxCell id="p1-ctx-nsp" value="Hive NSP (Laravel 12 + Blade)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="422" width="1580" height="390" as="geometry" /></mxCell><mxCell id="p1-ctx-ext" value="External systems" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#E6E6E6;stroke