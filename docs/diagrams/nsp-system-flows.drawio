ometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="3. Startup founder journey" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1976" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p3-title" value="3. Startup founder journey" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="36" as="geometry" /></mxCell><mxCell id="p3-sub" value="Register a startup (duplicate check or join), invite the team, set data-sharing consents, then use the growth and service modules. Each module needs its feature flag." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1400" height="40" as="geometry" /></mxCell><mxCell id="p3-a-t" value="A. Register a startup and build the team" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1600" height="28" as="geometry" /></mxCell><mxCell id="p3-a-f" value="Founder" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="292" width="2020" height="130" as="geometry" /></mxCell><mxCell id="p3-a-i" value="Invitee" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="422" width="2020" height="130" as="geometry" /></mxCell><mxCell id="p3-a-n" value="NSP" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#F