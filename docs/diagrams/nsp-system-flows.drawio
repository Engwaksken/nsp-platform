 confirmed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="p3-a-n"><mxGeometry x="710" y="10" width="200" height="110" as="geometry" /></mxCell><mxCell id="p3-a8" value="Confirm it is a different&lt;br&gt;company, submit again" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="p3-a-f"><mxGeometry x="717" y="27" width="186" height="76" as="geometry" /></mxCell><mxCell id="p3-a9" value="Create startup (active):&lt;br&gt;creator is owner; outbox&lt;br&gt;startup.created.v1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p3-a-n"><mxGeometry x="937" y="27" width="186" height="76" as="geometry" /></mxCell><mxCell id="p3-a10" value="Team page: invite by&lt;br&gt;email and role (owner,&lt;br&gt;founder, admin, team_&lt;br&gt;member, viewer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p3-a-n"><mxGeometry x="1157" y="27" width="186" height="76" as="geometry" /></mxCell><mxCell id="p3-a11" value="Invitee opens emailed&lt;br&gt;link /invitations/{token}&lt;br&gt;(valid 7 days)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="p3-a-i"><mxGeometry x="1377" y="27" width="186" height="76" as="geometry" /></mxCell><mxCell id="p3-a12" value="Invited email, startup&lt;br&gt;active, not on&lt;br&gt;the team?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="p3-a-n"><mxGeometry x="1590" y="10" width="200" height="110" as="geometry" /></mxCell><mxCell id="p3-a13" value="Error: invitation&lt;br&gt;not valid" style="rounded=1;arcSize=50;strokeWidth=2;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="p3-a-n"><mxGeometry x="1605" y="165" width="170" height="60" as="geometry" />