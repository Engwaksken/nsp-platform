APP_NAME="Hive NSP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Hive NSP ---
# Local email/password login (fallback until the shared Hive IdP is live).
NSP_LOCAL_LOGIN=true
# Admin roles must use two-factor sign-in (authenticator app). Only set false on a local development machine.
NSP_MFA_ENFORCE=true
# Startup registry (hosted in NSP, decision M8).
NSP_REGISTRY_ENABLED=true
# Growth assessments: founders see them only after Hive approves a rubric version.
NSP_VGI_ENABLED=true
# Opportunities and events directory (Phase 5a).
NSP_OPPORTUNITIES_ENABLED=true
# Funding requests, verified investors and private data rooms (Phase 5b).
NSP_FUNDING_ENABLED=true
# Experts, consultants and mentors (Phase 5c).
NSP_EXPERTS_ENABLED=true
# Talent and jobs board (Phase 5d). Application CV copies are deleted this many days after closing (pending decision D8).
NSP_TALENT_ENABLED=true
NSP_TALENT_CV_RETENTION_DAYS=180
# Marketplace and public startup directory (Phase 5e).
NSP_MARKETPLACE_ENABLED=true
# Optional AI writing assistant (Phase 6c). Stays locked until BOTH a key is set and legal review is recorded.
# Admins can set the key, model, effort, limits and legal approval in Admin → AI assistant instead;
# values saved there (key encrypted) take precedence over the ones below.
NSP_AI_ASSISTANT_ENABLED=false
NSP_AI_LEGAL_APPROVED=false
ANTHROPIC_API_KEY=
NSP_AI_MODEL=claude-opus-5-5
NSP_AI_EFFORT=medium
NSP_AI_DAILY_PER_USER=20
NSP_AI_DAILY_PER_STARTUP=50
NSP_AI_DAILY_TOTAL=500
# Backups (Phase 7a). Production refuses unencrypted backups: set a long random password and keep it outside the server too.
NSP_BACKUP_PASSWORD=
NSP_BACKUP_KEEP=14
# NSP_BACKUP_PATH=/home/account/nsp-backups
# Uptime monitor token for GET /health (Authorization: Bearer ...). Empty = endpoint off.
NSP_HEALTH_TOKEN=
# IMS integration (docs/integration-contract-v1.md). Off until clients are set up with `php artisan nsp:api-client`.
NSP_IMS_INTEGRATION=false
IMS_URL=
# Single sign-on through the shared Hive identity provider (OIDC, authorization code + PKCE).
NSP_OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI="${APP_URL}/auth/oidc/callback"
OIDC_POST_LOGOUT_REDIRECT_URI="${APP_URL}"
OIDC_SCOPES="openid profile email"
# Link an SSO login to an existing local account with the same verified email. Off until the owner approves (docs/decisions.md).
OIDC_LINK_VERIFIED_EMAIL=false
